{
  "name": "social-cosmos-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "persona:generate": "node --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local scripts/persona/generate.mjs",
    "persona:review": "node scripts/persona/review.mjs",
    "persona:validate": "node scripts/persona/validate.mjs",
    "persona:seed": "node --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local scripts/persona/seed.mjs",
    "persona:replay": "node --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local scripts/persona/replay.mjs",
    "persona:openviking-seed": "node --env-file-if-exists=.env.production scripts/persona/openviking-seed.mjs",
    "persona:recall": "node --env-file-if-exists=.env.production scripts/persona/recall-baseline.mjs",
    "persona:check": "node --env-file-if-exists=.env.development --env-file-if-exists=.env.development.local scripts/persona/check.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts tests/e2e playwright.config.ts vite.config.ts",
    "preview": "vite preview",
    "e2e:serve": "node scripts/e2e-server.mjs",
    "test:e2e": "playwright test",
    "test:e2e:parallel": "playwright test --workers=4",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:e2e:features": "playwright test tests/e2e/features --project=desktop",
    "test:e2e:report": "playwright show-report",
    "check:api": "node scripts/run-python.mjs -m pytest -q backend/tests",
    "db:upgrade": "node scripts/run-python.mjs -m alembic -c backend/alembic.ini upgrade head",
    "db:check": "node scripts/run-python.mjs -m alembic -c backend/alembic.ini check",
    "outbox:drain": "node scripts/run-python.mjs --cwd=backend -m app.outbox_worker --once",
    "agent-memory:drain": "node scripts/run-python.mjs --cwd=backend -m app.agent_memory_worker --once",
    "agent-memory:worker": "node scripts/run-python.mjs --cwd=backend -m app.agent_memory_worker",
    "chat:drain": "node scripts/run-python.mjs --cwd=backend -m app.chat_analysis_worker --once",
    "chat:worker": "node scripts/run-python.mjs --cwd=backend -m app.chat_analysis_worker",
    "simulation:tick": "node scripts/run-python.mjs --cwd=backend -m app.simulation_worker --once",
    "simulation:worker": "node scripts/run-python.mjs --cwd=backend -m app.simulation_worker",
    "seed:nebula-simulation": "cd backend && python -m app.dev_seed_nebula",
    "drill:agent-memory": "node --env-file-if-exists=.env.production scripts/drills/agent-memory.mjs",
    "drill:openviking": "node --env-file-if-exists=.env.production scripts/drills/openviking.mjs",
    "drill:all": "npm run drill:agent-memory && npm run drill:openviking"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "postprocessing": "^6.39.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.182.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
